colors_som <- env$group.colors[ind_som]

indata_pred <- env$indata[,ind_pred]
labels_pred <- env$group.labels[ind_pred]
colors_pred <- env$group.colors[ind_pred]

rm(envir = env)


env <- opossom.new(list(dataset.name = "G:/Other computers/Woring_main_laptop/Documents/SNPoSOM_files/test",
                        dim.1stLvlSom = "auto",
                        dim.2ndLvlSom = 10, #20
                        training.extension = 1,
                        rotate.SOM.portraits = 0,
                        flip.SOM.portraits = F,
                        feature.centralization = T,
                        sample.quantile.normalization = F,
                        snp.data.transformation = F,
                        replace.missing.genotype = T,
                        activated.modules = list("reporting" = T,
                                                 "geneset.analysis" = T)))

env$indata <- indata_som
env$group.colors <- colors_som
env$group.labels <- labels_som

opossom.run(env)
